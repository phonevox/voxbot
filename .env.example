NODE_ENV=development

## PostgreSQL
DATABASE_URL=postgresql://postgres:admin@localhost:5432/yourdatabase
DATABASE_SSL=false # true só pra Postgres gerenciado que exige (Heroku, RDS, Supabase...)

## Docker (só docker-compose)
# POSTGRES_DB=botdb
# POSTGRES_PASSWORD=postgres

## Bot
OWNER_IDS=188851299255713792
DEFAULT_PREFIX=!
DEFAULT_QUIP_JOKE_LEVEL=0 # 0 (sério) a 3 (mais engraçadinho)

## Logs
LOG_LEVEL=verbose # arquivo: error|warn|info|debug|verbose
CONSOLE_LOG_LEVEL=debug # terminal, geralmente mais silencioso que o arquivo
LOG_RETENTION_DAYS=14
# LOG_MAX_SIZE=20m # também rotaciona cedo passando desse tamanho, além da rotação diária

## Outros
ENCRYPTION_KEY="somerandomvaluetouseasencryptionkey"

# Discord
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here

## Integração Zabbix (cog zabbix) - opcional; falta de variável só desativa o cog, não o bot.
# MOD_ZABBIX_INGEST_PORT=3001
# MOD_ZABBIX_WEBHOOK_PATH=/webhook
# MOD_ZABBIX_WEBHOOK_SECRET=segredo-compartilhado-configurado-no-media-type-do-zabbix
# MOD_ZABBIX_ALLOWED_HOST=zabbix.falevox.com.br
# MOD_ZABBIX_API_URL=https://zabbix.example.com/api_jsonrpc.php
# MOD_ZABBIX_WEB_URL=https://zabbix.example.com
# MOD_ZABBIX_API_USER=discord-bot-service-account
# MOD_ZABBIX_API_PASSWORD=change-me
# MOD_ZABBIX_FORUM_CHANNEL_ID=id_do_canal_forum_do_discord
# MOD_ZABBIX_RECONCILE_INTERVAL_MS=300000
# MOD_ZABBIX_ARCHIVE_DELAY_MS=86400000
# MOD_ZABBIX_RECONCILE_SINCE=start # start|ever|never|<timestamp unix>
# MOD_ZABBIX_TZ_OFFSET_MINUTES=0 # timezone que o SERVIDOR do Zabbix (não o frontend) usa nas macros de alerta

## Auto-Bloqueador (cog autobloqueador) - opcional; só o "rechecar" precisa disso.
# MOD_AUTOBLOQUEADOR_URL=https://example.com/update
# MOD_AUTOBLOQUEADOR_TOKEN=change-me
